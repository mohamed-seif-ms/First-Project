# Claude AI (from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Meta App Credentials (from developers.facebook.com)
META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here

# Long-lived Access Token (User or System User token)
META_ACCESS_TOKEN=your_access_token_here

# Ad Account ID (without "act_" prefix)
META_AD_ACCOUNT_ID=your_ad_account_id_here

# Facebook Page ID
META_PAGE_ID=your_page_id_here

# Meta Graph API version
META_API_VERSION=v19.0

# Webhook verification token (any random string you choose)
META_WEBHOOK_VERIFY_TOKEN=your_random_webhook_token

# Server port
PORT=3000
